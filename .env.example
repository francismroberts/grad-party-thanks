# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Used only by the local ingest pipeline in scripts/. The site itself
# uses the public publishable key in assets/supabase-config.js.

# Service role key — bypasses RLS. Needed to write photos rows and
# upload to the gallery bucket. Supabase dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults to the project URL in assets/supabase-config.js.
# SUPABASE_URL=https://izlbkbwchwxstksfygqt.supabase.co
